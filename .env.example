# Victor Noctis — Environment Variables Template
# Copy this file to .env.local and populate the secrets

# 1. AI Intelligence Core (System 01)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback providers
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 2. Supabase Infrastructure (System 07)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Knowledge & Capabilities (System 04 & 05)
BRAVE_SEARCH_API_KEY=
